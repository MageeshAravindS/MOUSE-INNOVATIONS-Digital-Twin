# ==============================================================================
# EduNexus Production & Deployment Environment Variables
# Copy this file to .env and configure for your target environment.
# ==============================================================================

# Database Configuration:
# - Leave blank to use local SQLite (edunexus.db)
# - For PostgreSQL (Render, Supabase, Neon, Railway, AWS RDS):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Security & Authentication:
# Generate a secure 32+ character key for JWT signing:
EDUNEXUS_SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# Comma-separated list of instructor/staff emails:
STAFF_EMAILS=teacher@edunexus.edu,admin@edunexus.edu

# ==============================================================================
# AI Teacher Provider & Cloud Settings
# ==============================================================================
# Options: "groq" (recommended for cloud), "gemini", "openai", or "ollama" (local GPU)
LLM_PROVIDER=groq

# Option 1: Groq (Fast & Free tier available at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Option 2: Google Gemini (Free tier available at https://aistudio.google.com)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# Option 3: OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Option 4: Local Ollama (Only if self-hosting on a machine with NVIDIA GPU)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=edunexus-qwen3

# ==============================================================================
# Optional Hardware Lab Settings (For Physical Laboratory Computers)
# ==============================================================================
# RELAY_SERIAL_PORT=COM3
# RELAY_SERIAL_BAUD=115200
